##
## Stable public quality entry points used by local workflows and CI.
function test {
    go:test "$@"
}

function lint {
    go:lint "$@"
}

function go:tools:golangci-lint {
    local version

    version="$(_go:golangci_lint_version)" || return 1
    _go:tool:install \
        "golangci-lint" \
        "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${version}"
}

function go:tools:govulncheck {
    _go:tool:install \
        "govulncheck" \
        "golang.org/x/vuln/cmd/govulncheck@${GO_GOVULNCHECK_VERSION}"
}

function go:tools:gosec {
    _go:tool:install \
        "gosec" \
        "github.com/securego/gosec/v2/cmd/gosec@${GO_GOSEC_VERSION}"
}

function go:tools:all {
    go:tools:golangci-lint || return 1
    go:tools:govulncheck || return 1
    go:tools:gosec || return 1
}

function go:fmt {
    local gofmt_bin
    local -a files=()

    gofmt_bin="$(dirname "$(_go:bin)")/gofmt"
    while IFS= read -r file; do
        if [ -n "${file}" ]; then
            files+=("${file}")
        fi
    done < <(_go:files)
    if [ "${#files[@]}" -eq 0 ]; then
        echo "No Go files found"
        return 0
    fi

    "${gofmt_bin}" -w "${files[@]}"
}

function go:fix {
    local go_bin

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${go_bin}" fix ./...
}

function go:fmt:check {
    local gofmt_bin
    local -a files=()
    local unformatted

    gofmt_bin="$(dirname "$(_go:bin)")/gofmt"
    while IFS= read -r file; do
        if [ -n "${file}" ]; then
            files+=("${file}")
        fi
    done < <(_go:files)
    if [ "${#files[@]}" -eq 0 ]; then
        echo "No Go files found"
        return 0
    fi

    unformatted="$("${gofmt_bin}" -l "${files[@]}")"
    if [ -n "${unformatted}" ]; then
        echo "The following Go files need formatting:"
        echo "${unformatted}"
        return 1
    fi
}

function go:test {
    local go_bin

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${go_bin}" test "$@" ./...
}

function go:race {
    local go_bin

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${go_bin}" test -race -count=1 "$@" ./...
}

function go:cover {
    local go_bin
    local module
    local output_file=${GO_COVERPROFILE:-coverage.out}

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    while IFS= read -r module; do
        if [ "${module}" = "." ]; then
            "${go_bin}" test -coverprofile="${output_file}" ./... \
                && "${go_bin}" tool cover -func "${output_file}" || return 1
        else
            (cd "${module}" \
                && "${go_bin}" test -coverprofile="${output_file}" ./... \
                && "${go_bin}" tool cover -func "${output_file}") || return 1
        fi
    done < <(_go:module_dirs)
}

function _go:golangci-lint:ensure {
    local version

    version="$(_go:golangci_lint_version)" || return 1
    _go:tool:ensure \
        "golangci-lint" \
        "github.com/golangci/golangci-lint/v2" \
        "${version}" \
        "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${version}"
}

function go:lint {
    local golangci_lint_bin

    golangci_lint_bin=$(_go:golangci-lint:ensure) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${golangci_lint_bin}" run "$@" ./...
}

function go:lint:fix {
    local golangci_lint_bin

    golangci_lint_bin=$(_go:golangci-lint:ensure) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${golangci_lint_bin}" run --fix "$@" ./...
}

function go:lint:new {
    local golangci_lint_bin

    golangci_lint_bin=$(_go:golangci-lint:ensure) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules \
        "${golangci_lint_bin}" run \
        --new-from-rev="${GO_LINT_NEW_FROM_REV}" \
        --whole-files "$@" ./...
}

function go:lint:report {
    local golangci_lint_bin

    golangci_lint_bin=$(_go:golangci-lint:ensure) || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules \
        "${golangci_lint_bin}" run --issues-exit-code=0 "$@" ./...
}

function go:security:govulncheck {
    local govulncheck_bin

    govulncheck_bin=$(_go:tool:ensure \
        "govulncheck" \
        "golang.org/x/vuln" \
        "${GO_GOVULNCHECK_VERSION}" \
        "golang.org/x/vuln/cmd/govulncheck@${GO_GOVULNCHECK_VERSION}") || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${govulncheck_bin}" "$@" ./...
}

function go:security:gosec {
    local gosec_bin

    gosec_bin=$(_go:tool:ensure \
        "gosec" \
        "github.com/securego/gosec/v2" \
        "${GO_GOSEC_VERSION}" \
        "github.com/securego/gosec/v2/cmd/gosec@${GO_GOSEC_VERSION}") || return 1
    _go:quality:prepare_env || return 1
    _go:run_in_modules "${gosec_bin}" -exclude-dir=.tmp "$@" ./...
}

function go:security:all {
    go:security:govulncheck "$@" || return 1
    go:security:gosec "$@" || return 1
}

function go:quality:pr {
    go:fmt:check || return 1
    go:test || return 1
    go:lint:new || return 1
}

function go:quality:all {
    go:fmt:check || return 1
    go:fmt || return 1
    go:fix || return 1
    go:test || return 1
    go:race || return 1
    go:lint || return 1
    go:security:all || return 1
}


function go:mod:update {
    local modules
    local extra=()
    local mod
    local root
    local latest
    local root_latest
    local resolved
    local current_mod

    if ! command -v rg >/dev/null 2>&1; then
        lgr ERR "rg is required to list goliatone modules"
        return 1
    fi

    # Get current module name to exclude from updates (avoid self-update and submodules)
    current_mod=$(go list -m)

    modules=$(rg -o 'github.com/goliatone/[^[:space:]]+' go.mod | sort -u | grep -v "^${current_mod}")
    if [ -z "$modules" ]; then
        lgr ERR "no goliatone modules found in go.mod"
        return 1
    fi

    lgr I "updating goliatone modules to latest..."
    for mod in $modules; do
        latest=""
        resolved=0
        if latest=$(go list -m -u -f '{{if .Update}}{{.Update.Version}}{{else}}{{.Version}}{{end}}' "$mod" 2>/dev/null); then
            resolved=1
        fi

        if [ "$resolved" -eq 1 ] && [ -n "$latest" ]; then
            lgr I "go get ${mod}@${latest}"
            go get "${mod}@${latest}" || return 1
            continue
        fi

        lgr WARN "failed to resolve latest for ${mod}, trying ${mod}@latest"
        if go get -u "${mod}@latest"; then
            continue
        fi

        root=$(echo "$mod" | awk -F/ '{print $1"/"$2"/"$3}')
        if [ "$root" != "$mod" ]; then
            root_latest=""
            if root_latest=$(go list -m -u -f '{{if .Update}}{{.Update.Version}}{{else}}{{.Version}}{{end}}' "$root" 2>/dev/null); then
                lgr WARN "failed to update ${mod}, retrying ${root}@${root_latest}"
                go get "${root}@${root_latest}" || return 1
            else
                lgr WARN "failed to resolve ${root}, retrying ${root}@latest"
                go get -u "${root}@latest" || return 1
            fi
        else
            return 1
        fi
    done

    if [ "$#" -gt 0 ]; then
        for mod in "$@"; do
            extra+=("${mod}@latest")
        done
        lgr I "updating extra modules: ${extra[*]}"
        go get -u "${extra[@]}" || return 1
    fi

    go mod tidy
}


##
## -----
##
## docs:lint
##
## Lint changed, tracked Markdown docs using markdownlint (CLI or npx)
## DOCS_LINT_BASE selects the comparison commit; DOCS_LINT_GLOB can override
## changed-file discovery for an explicit local full-tree check.
function docs:lint {
    local docs_base="${DOCS_LINT_BASE:-${GO_LINT_NEW_FROM_REV}}"
    local -a docs=()

    set -euo pipefail
    if [ -n "${DOCS_LINT_GLOB:-}" ]; then
        while IFS= read -r file; do
            [ -n "${file}" ] && docs+=("${file}")
        done < <(find . -type f -name "${DOCS_LINT_GLOB}" \
            -not -path './.git/*' -not -path './.ctx/*' \
            -not -path './.tmp/*' -not -path './tmp/*' \
            -not -path './node_modules/*' | sort)
    elif git rev-parse --verify "${docs_base}^{commit}" >/dev/null 2>&1; then
        while IFS= read -r file; do
            case "${file}" in
                .ctx/*|.tmp/*|tmp/*|node_modules/*) continue ;;
            esac
            [ -n "${file}" ] && docs+=("${file}")
        done < <(git diff --name-only --diff-filter=ACMR "${docs_base}" HEAD -- '*.md')
    fi

    if [ "${#docs[@]}" -eq 0 ]; then
        echo "No changed Markdown files to lint"
        return 0
    fi

    if command -v markdownlint >/dev/null 2>&1; then
        markdownlint "${docs[@]}"
    elif command -v npx >/dev/null 2>&1; then
        npx --yes markdownlint-cli2 "${docs[@]}"
    else
        echo "markdownlint (or npx) is required for docs:lint" >&2
        exit 1
    fi
}

